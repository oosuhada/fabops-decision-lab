FABOPS_POSTGRES_PASSWORD=replace-with-generated-local-secret
FABOPS_NEO4J_PASSWORD=replace-with-generated-local-secret
FABOPS_API_PORT=8000
FABOPS_WEB_PORT=5173

# Optional v0.7 grounded narration. Keep deterministic for the deployed v0.6
# soak. "auto" tries local first, then Vertex, then deterministic fallback.
FABOPS_NARRATION_MODE=deterministic
FABOPS_PUBLIC_NARRATION_CACHE_ONLY=true
FABOPS_PUBLIC_AI_DEMO_ENABLED=false

# Production deployments should point this at a private authenticated FabOps
# narration gateway, not at raw LM Studio and never at a public listener.
FABOPS_LOCAL_LLM_BASE_URL=http://private-narration-gateway.example:1240/v1
FABOPS_LOCAL_LLM_MODEL=local-review-qwen-next
FABOPS_LOCAL_LLM_TIMEOUT_SECONDS=45
FABOPS_LOCAL_LLM_MAX_RPM=20
FABOPS_LOCAL_LLM_MAX_CONCURRENCY=2
FABOPS_LOCAL_LLM_DAILY_REQUEST_LIMIT=500
FABOPS_LOCAL_LLM_DAILY_ESTIMATED_TOKEN_LIMIT=1000000
FABOPS_LOCAL_LLM_CIRCUIT_FAILURE_THRESHOLD=3
FABOPS_LOCAL_LLM_CIRCUIT_COOLDOWN_SECONDS=60
FABOPS_LOCAL_LLM_MAX_OUTPUT_TOKENS=700

FABOPS_VERTEX_PROJECT=your-gcp-project-id
FABOPS_VERTEX_LOCATION=global
FABOPS_VERTEX_MODEL=gemini-2.5-flash-lite
FABOPS_VERTEX_AUTH_MODE=adc
FABOPS_VERTEX_MAX_RPM=6
FABOPS_VERTEX_MAX_CONCURRENCY=1
FABOPS_VERTEX_DAILY_REQUEST_LIMIT=50
FABOPS_VERTEX_DAILY_ESTIMATED_TOKEN_LIMIT=120000
FABOPS_VERTEX_CIRCUIT_FAILURE_THRESHOLD=2
FABOPS_VERTEX_CIRCUIT_COOLDOWN_SECONDS=120
FABOPS_VERTEX_MAX_OUTPUT_TOKENS=600

# Runtime secrets are intentionally omitted from the public repository:
# FABOPS_LOCAL_LLM_TOKEN
# FABOPS_DEMO_SESSION_SECRET
# FABOPS_INTERNAL_NARRATION_TOKEN
