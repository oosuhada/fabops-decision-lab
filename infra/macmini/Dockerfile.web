FROM node:22-alpine AS build

ARG FABOPS_RELEASE_VERSION=0.6.0
ARG FABOPS_RELEASE_HASH
ARG FABOPS_DEPLOY_GIT_SHA
ARG VITE_API_URL=""

WORKDIR /app

COPY systems/web/package.json systems/web/package-lock.json ./
RUN npm ci

COPY systems/web/ ./
ENV VITE_API_URL=${VITE_API_URL}
RUN npm run build

FROM nginx:1.27-alpine

ARG FABOPS_RELEASE_VERSION=0.6.0
ARG FABOPS_RELEASE_HASH
ARG FABOPS_DEPLOY_GIT_SHA

LABEL org.opencontainers.image.title="FabOps Decision Lab Web" \
      org.opencontainers.image.version="${FABOPS_RELEASE_VERSION}" \
      org.opencontainers.image.revision="${FABOPS_DEPLOY_GIT_SHA}" \
      com.oosu.fabops.release-hash="${FABOPS_RELEASE_HASH}"

COPY --from=build /app/dist /usr/share/nginx/html
COPY infra/macmini/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
